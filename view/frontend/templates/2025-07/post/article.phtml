<?php
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $width = (int)$block->getBackgroundImageWidth() ?: 1920;
    $imageHelper = $this->helper(\Magefan\Blog\Helper\Image::class);
    $templateType = $block->getNewDesignType();
    $style = null;
    if ($templateType) {
        preg_match('/templates-\d+/', $templateType, $matches);
        $style = $matches[0] ?? '';
    }
?>
<?php
    $_postCollection = $block->getPostCollection();
?>
<?php if ($_postCollection->count() && $templateType): ?>
    <div class="blog-articles <?=trim($templateType)?>">
        <?php foreach ($_postCollection as $_post):
            $entity = $_post
            ?>
        <article class="blog-article">
            <div class="article-post">

                <?php /* Post Image Container */ ?>
                <?php if ($preparedImg = ($entity->getFeaturedListImg() ?: $entity->getFeaturedImg() )): ?>
                <div class="article-post__image-container animation-type--zoom">
                    <?php
                        $featuredImage = $imageHelper->init($preparedImg)->resize($width, null, false);
                        $featuredImgAlt = $_post->getData('featured_list_img_alt') ?: $_post->getData('featured_img_alt');
                        if (!$featuredImgAlt) {
                            $featuredImgAlt = $_post->getTitle();
                        }
                    ?>

                    <?php /* if ($preparedImg) { ?>
                     <?php  <div class="animation-type-zoom bg-img mfblogunveil" data-original="<?= $block->escapeHtml($featuredImage) ?>"></div>
                    } */ ?>

                    <a href="<?= $entity->getPostUrl() ?>"
                       class="article-post__image-wrapper mf-media mf-media--3x2 mf-media--transparent">
                        <img loading="lazy" class="motion-reduce" src="<?=  $block->escapeHtml($featuredImage) ?>"
                             alt="<?= $featuredImgAlt ?>">
                    </a>

                    <?php /* Post Category in Image Container */ ?>
                    <?php /* Not Visible */ ?>
                    <?php if ($preparedCategories = $entity->getParentCategories()): ?>
                    <?php if(!in_array($templateType, [
                        'article-grid',
                        'article-templates-1-1', 'article-templates-1-2', 'article-templates-1-3',
                        'article-templates-2-1', 'article-templates-2-2', 'article-templates-2-3',
						'article-templates-2-4', 'article-templates-2-5', 'article-templates-2-6',
                        'article-templates-3-1', 'article-templates-3-2', 'article-templates-3-3',
                        'article-templates-4-1', 'article-templates-4-2', 'article-templates-4-3',
                        'article-templates-4-4', 'article-templates-4-5', 'article-templates-4-6',
                        'article-templates-5-2', 'article-templates-5-3', 'article-templates-5-4',
						'article-items',
                        'article-slider',
                        'sidebar-article-grid', 'sidebar-article-list'
                    ])): ?>
                    <div class="article-post__category">
                        <?php foreach ($preparedCategories as $prepareCategory): ?>
                            <a class="article-post__category-name" href="<?= $prepareCategory->getCategoryUrl() ?>"
                               title="<?= $prepareCategory->getTitle() ?>"><?=$prepareCategory->getTitle()?></a>
                        <?php endforeach; ?>
                    </div>
                    <?php endif ?>
                    <?php endif ?>
                    <?php /* END Post Category in Image Container */ ?>

                    <?php /* Post Info in Image Container */ ?>
                    <?php /* Visible */ ?>
                    <?php if (in_array($templateType, [
                        'article-templates-4-1', 'article-templates-4-2', 'article-templates-4-3',
                        'article-templates-4-4', 'article-templates-4-5', 'article-templates-4-6',
                        'article-templates-5-2', 'article-templates-5-3', 'article-templates-5-4'
                    ])): ?>
                    <div class="article-post__info">

                        <div class="article-post__title">
                            <a href="<?= $entity->getPostUrl() ?>"><?=$entity->getTitle()?></a>
                        </div>

                        <div class="article-post__data-wrap">
                            <?php if ($block->authorEnabled() && ($author = $entity->getAuthor())): ?>
                                <?php
                                $author = $entity->getAuthor();
                                $fullName = $author->getTitle();
                                $authorUrl = $author->getAuthorUrl();
                                $coAuthors = $_post->getRelatedCoauthors();
                                $coAuthorsCount = count($coAuthors);
                                ?>
                                <?php if ($fullName): ?>
                                    <span class="article-post__author"><a
                                                href="<?= $authorUrl ?>"><span><?=$fullName?></span></a>
                                            <?php if ($coAuthorsCount) { ?>
                                                <?= $block->escapeHtml(__('and')) ?>
                                                <?php $z = 0 ?>
                                                <?php foreach($coAuthors as $coAuthor) { ?>
                                                    <?php $z++; ?>
                                                    <?php if ($block->authorPageEnabled()) { ?>
                                                        <a title="<?= $block->escapeHtml($coAuthor->getTitle()) ?>"
                                                           href="<?= $block->escapeUrl($coAuthor->getAuthorUrl()) ?>"><?= $block->escapeHtml($coAuthor->getTitle()) ?></a><?php if ($z != $coAuthorsCount) echo ', ' ?>
                                                    <?php } else { ?>
                                                        <?= $block->escapeHtml($coAuthor->getTitle()) ?><?php if ($z != $coAuthorsCount) echo ', ' ?>
                                                    <?php } ?>
                                                <?php } ?>
                                            <?php } ?>
                                    </span>
                                <?php endif ?>
                            <?php endif ?>

                            <?php if ($_post->isPublishDateEnabled()) { ?>
                                <span class="article-post__data"><span class="divider">&nbsp;|&nbsp;</span><?= $block->escapeHtml($_post->getPublishDate()) ?></span>
                            <?php } ?>

							<?php if ($block->readingTimeEnabled() && $_post->getReadingTime()) { ?>
                                <?php /* <i class="mf-blog-icon mfbi-reading-time"></i>*/ ?>
                                <span class="article-post__reading-time"><span class="divider">&nbsp;|&nbsp;</span><?= $block->escapeHtml($_post->getReadingTime()) . ' ' . __('min read') ?></span>
							<?php } ?>

                            <?php if ($block->viewsCountEnabled()) { ?>
                                <?php if ($viewsCount = $_post->getViewsCount()) { ?>
                                    <span class="article-post__count-comments"><?= $viewsCount ?></span>
                                <?php } ?>
                            <?php } ?>

                        </div>

                        <?php if (!in_array($templateType, ['article-templates-4-'])): ?>
                            <?php if (!empty($preparedCategories)): ?>
                                <div class="article-post__category">
                                    <?php foreach ($preparedCategories as $prepareCategory): ?>
                                        <a class="article-post__category-name" href="<?= $prepareCategory->getCategoryUrl() ?>"
                                           title="<?= $prepareCategory->getTitle() ?>"><?=$prepareCategory->getTitle()?></a>
                                    <?php endforeach; ?>
                                </div>
                            <?php endif ?>
                        <?php endif ?>
                    </div>
                    <?php endif ?>
                    <?php /* END Post Info in Image Container */ ?>

                </div>
                <?php endif ?>
                <?php /* END Post Image Container */ ?>


                <?php /* Post Info */ ?>
                <?php if (in_array($templateType, [
                    'article-grid', 'article-list',
                    'article-templates-1-1', 'article-templates-1-2', 'article-templates-1-3',
                    'article-templates-2-1', 'article-templates-2-2', 'article-templates-2-3',
					'article-templates-2-4', 'article-templates-2-5', 'article-templates-2-6',
                    'article-templates-3-1', 'article-templates-3-2', 'article-templates-3-3',
					'article-templates-5-1',
                    'article-items',
                    'sidebar-article-grid', 'sidebar-article-list'])):
                    ?>
                <div class="article-post__info">
                    <div class="article-post__header">
                        <h2 class="article-post__title">
                            <a href="<?= $entity->getPostUrl() ?>"><?=$entity->getTitle()?></a>
                        </h2>

                        <?php /* Not Visible */ ?>
                        <?php if (!in_array($templateType, [
							'article-items'
                        ])): ?>
                            <div class="article-post__data-wrap">
                                <?php if (!in_array($templateType, [
                                        'sidebar-article-grid', 'sidebar-article-list'
                                    ]) && $block->authorEnabled() && ($author = $entity->getAuthor())): ?>
                                <?php
                                    $author = $entity->getAuthor();
                                    $fullName = $author->getTitle();
                                    $authorUrl = $author->getAuthorUrl();
                                    $coAuthors = $_post->getRelatedCoauthors();
                                ?>
                                <?php if ('' !== $fullName): ?>
                                <span class="article-post__author"><a href="<?= $authorUrl ?>"><span><?=$fullName?></span></a>
                                    <?php if (count($coAuthors)) { ?>
                                        <?= $block->escapeHtml(__('and')) ?>
                                        <?php $z = 0 ?>
                                        <?php foreach($coAuthors as $coAuthor) { ?>
                                            <?php $z++; ?>
                                            <?php if ($block->authorPageEnabled()) { ?>
                                                <a title="<?= $block->escapeHtml($coAuthor->getTitle()) ?>"
                                                   href="<?= $block->escapeUrl($coAuthor->getAuthorUrl()) ?>"><?= $block->escapeHtml($coAuthor->getTitle()) ?></a><?php if ($z != count($coAuthors)) echo ', ' ?>
                                            <?php } else { ?>
                                                <?= $block->escapeHtml($coAuthor->getTitle()) ?><?php if ($z != count($coAuthors)) echo ', ' ?>
                                            <?php } ?>
                                        <?php } ?>
                                    <?php } ?>
                                </span>
                                <?php endif ?>
                            <?php endif ?>

                            <span class="article-post__data"><span class="divider">&nbsp;|&nbsp;</span> <?= $block->escapeHtml($_post->getPublishDate()) ?></span>

                            <?php /* Not Visible */ ?>
                            <?php if (!in_array($templateType, [
                                'sidebar-article-grid', 'sidebar-article-list'
                            ])): ?>

                            <?php if ($block->readingTimeEnabled() && $_post->getReadingTime()) { ?>
                                <?php /* <i class="mf-blog-icon mfbi-reading-time"></i>*/ ?>
                                <span class="article-post__reading-time"><span class="divider">&nbsp;|&nbsp;</span><?= $block->escapeHtml($_post->getReadingTime()) . ' ' . __('min read') ?></span>
                            <?php } ?>

                            <?php if ($postCommentsCount = count($entity->getComments())): ?>
                                <span class="article-post__count-comments"><?= $postCommentsCount ?></span>
                            <?php endif ?>
                        <?php endif ?>
                        </div>
					<?php endif ?>
                    </div>

                    <?php /* Not Visible */ ?>
                    <?php /* Short Content */ ?>
                    <?php if (!in_array($templateType, [
                         'article-templates-1-2', 'article-templates-1-3',
						 'article-templates-2-4', 'article-templates-2-5', 'article-templates-2-6',
                         'article-items',
                         'article-slider',
                         'sidebar-article-grid', 'sidebar-article-list'
                    ])): ?>
                        <div class="article-post__content">
                            <?= $entity->getShortFilteredContentWithoutImages() ?>
                        </div>
                    <?php endif ?>

                    <?php /* Visible */ ?>
					<?php /* Post Category in Post Info */ ?>
                    <?php if ($preparedCategories = $entity->getParentCategories()): ?>
                        <?php if (!in_array($templateType, [
                            'article-templates-4-1', 'article-templates-4-2', 'article-templates-4-3',
                            'article-templates-5-2', 'article-templates-5-3',
                            'article-items',
                            'article-slider',
                            'sidebar-article-grid', 'sidebar-article-list'
                        ])):
                        ?>
                        <div class="article-post__footer">

                            <div class="article-post__category">
                                <?php foreach ($preparedCategories as $prepareCategory): ?>
                                <a class="article-post__category-name" href="<?= $prepareCategory->getCategoryUrl() ?>"
                                   title="<?= $prepareCategory->getTitle() ?>"><?=$prepareCategory->getTitle()?></a>
                                <?php endforeach; ?>
                            </div>

                        </div>
							<?php /* END Post Category in Post Info */ ?>
						<?php endif ?>
					<?php endif ?>
                </div>
                <?php endif ?>
                <?php /* END Post Info */ ?>

                <?php /* Visible */ ?>
                <?php if (in_array($templateType, [
					'article-templates-4-4', 'article-templates-4-5', 'article-templates-4-6',
                ])): ?>
                <div class="article-post__content">
                    <?= $entity->getShortFilteredContentWithoutImages() ?>
                </div>
                <?php endif ?>

            </div>
        </article>

        <?php endforeach; ?>
    </div>

    <?= $block->getToolbarHtml() ?>
    <?php if ($style) { ?>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var f = '<?= $block->getViewFileUrl('Magefan_BlogExtra::css/style-' . $style . '.css') ?>';

                if (!document.querySelector('link[href="' + f + '"]')) {
                    var link = document.createElement('link');
                    link.rel = 'stylesheet';
                    link.type = 'text/css';
                    link.href = f;
                    document.head.appendChild(link);
                }
            });
        </script>

    <?php } ?>
<?php endif ?>
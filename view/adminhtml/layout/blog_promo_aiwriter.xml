<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magefan\Community\Block\Adminhtml\Promo" name="mfblog.promo.ai_writer">
                <arguments>
                    <argument name="plan" xsi:type="string">extra</argument>
                    <argument name="badge" xsi:type="string" translate="true">Extra Plan Feature</argument>
                    <argument name="title" xsi:type="string" translate="true">New Post With AI</argument>
                    <argument name="description" xsi:type="string" translate="true">Generate complete blog posts with ChatGPT in a few clicks and save hours on content writing.</argument>
                    <argument name="features" xsi:type="array">
                        <item name="f0" xsi:type="string" translate="true">Generate a post from a topic, keywords and tone of voice</item>
                        <item name="f1" xsi:type="string" translate="true">Use your own prompt templates</item>
                        <item name="f2" xsi:type="string" translate="true">Choose the ChatGPT model that fits your needs</item>
                        <item name="f3" xsi:type="string" translate="true">Review and edit the generated post before publishing</item>
                    </argument>
                    <argument name="section" xsi:type="string">mfblog</argument>
                    <argument name="module_name" xsi:type="string">Magefan_Blog</argument>
                    <argument name="utm_campaign" xsi:type="string">blog</argument>
                    <argument name="button_label" xsi:type="string" translate="true">Upgrade to Extra</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>

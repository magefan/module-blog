/**
 * @var \Magefan\Blog\Block\Adminhtml\VersionsManager $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magefan\Community\Api\SecureHtmlRendererInterface $mfSecureRenderer
 */

if ($block->isBlogExtraInstalled()) {
    return;
}

$currentPlan  = $block->getCurrentPlan();
$extraSelectors = $block->getExtraSelectors();
$plusSelectors  = $currentPlan !== 'Plus' ? $block->getPlusSelectors() : [];

$selectorMap = [
    'Extra' => $extraSelectors,
    'Plus'  => $plusSelectors,
];
?>

<?php $script = "
    var versionsManager = {
        _currentPlan: " . json_encode($currentPlan) . ",
        _selector: " . json_encode($selectorMap) . ",

        _attachHandlers: function (element, plan) {
            if (element._vmAttached) return;
            element._vmAttached = true;
            if (element.tagName == 'SELECT') {
                element.addEventListener('mousedown', function () {
                    this._previousValue = this.value;
                });
                element.addEventListener('change', function () {
                    if (this._isResetting) return;
                    versionsManager.showAlert(plan);
                    this._isResetting = true;
                    this.value = this._previousValue !== undefined ? this._previousValue : '';
                    this.dispatchEvent(new Event('change', { bubbles: true }));
                    this._isResetting = false;
                });
            } else {
                element.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    versionsManager.showAlert(plan);
                });
                element.querySelectorAll('select').forEach(function (select) {
                    select.addEventListener('mousedown', function () {
                        this._previousValue = this.value;
                    });
                    select.addEventListener('change', function () {
                        if (this._isResetting) return;
                        versionsManager.showAlert(plan);
                        this._isResetting = true;
                        this.value = this._previousValue !== undefined ? this._previousValue : '';
                        this.dispatchEvent(new Event('change', { bubbles: true }));
                        this._isResetting = false;
                    });
                });
            }
        },

        initListener: function () {
            const observer = new MutationObserver(mutations => {
                mutations.forEach(mutation => {
                    for (let plan in versionsManager._selector) {
                        let planFeatures = versionsManager._selector[plan];

                        planFeatures.forEach(selector => {
                            const elements = document.querySelectorAll(selector);
                            if (elements.length) {
                                elements.forEach(function (element) {
                                    versionsManager._attachHandlers(element, plan);
                                });
                            }
                        });
                    }
                });
            });

            observer.observe(document.body, { childList: true, subtree: true });
        },

        showAlert: function (extensionPlan) {
            if (versionsManager._alertOpen) return;
            versionsManager._alertOpen = true;
            require(['jquery', 'Magento_Ui/js/modal/alert'], function(\$, alert) {
                if (extensionPlan === 'Plus') {
                    extensionPlan = 'Plus or Extra';
                }
                alert({
                    title: '" . $escaper->escapeHtml(__('You cannot use this option.')) . "',
                    content: '" . $escaper->escapeHtml(__('This feature is available in')) . " <strong>' + extensionPlan + '</strong> " . $escaper->escapeHtml(__('plan only.')) . "',
                    buttons: [{
                        text: '" . $escaper->escapeHtml(__('Upgrade Plan Now')) . "',
                        class: 'action primary accept',
                        click: function () {
                            window.open('https://magefan.com');
                        }
                    }],
                    closed: function () {
                        versionsManager._alertOpen = false;
                    }
                });
            });
        }
    };

    versionsManager.initListener();
"; ?>

<?= /* @noEscape */ $mfSecureRenderer->renderTag('script', [], $script, false) ?>
